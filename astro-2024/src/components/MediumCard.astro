---
import { IconsMapper } from "./tag/Tag.utils.astro";
import type { OpenSourceProject } from "../content/projects.types";

type Props = OpenSourceProject;

const { image, name, link } = Astro.props;
---

<article
  class="flex flex-col gap-8  bg-transparent/[0.3] p-8 rounded-xl items-center w-[100%] md:w-[200px] min-h-[100%] justify-end self-stretch justify-between"
>
  {image && <img src={image} alt={name} class="w-40 " />}
  <a
    href={link}
    class="text-white bg-gray-900 outline-none ring-1 ring-gray-100 font-medium rounded-lg text-sm px-3 py-3 w-fit self-center neon-shadow h-[50%]"
    >{name}</a
  >
</article>
